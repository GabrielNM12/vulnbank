@{
    ViewData["Title"] = "Entrar";
    ViewBag.BodyClass = "auth";
}

<div class="auth-brand"><span class="logo"></span> Nimbus Bank</div>
<p class="auth-sub">Acesse sua conta</p>

<div class="card">
    @if (ViewBag.Error != null)
    {
        <div class="error">@ViewBag.Error</div>
    }

    <form method="post" action="/Home/Login">
        <label>Usuário</label>
        <input type="text" name="username" autocomplete="off" autofocus />

        <label>Senha</label>
        <input type="password" name="password" autocomplete="off" />

        <button class="btn block accent" type="submit" style="margin-top:22px">Entrar</button>
    </form>
</div>
